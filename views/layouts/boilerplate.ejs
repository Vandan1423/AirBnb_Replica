<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>AirBnb_Replica</title>
        <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css" />
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
            integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"
        />
        <link rel="stylesheet" href="/css/styles.css" />
    </head>
    <body>
        <!-- Loading Screen -->
        <div id="loader-wrapper">
            <div class="loader-content">
                <div class="loader-logo">
                    <i class="fa-brands fa-airbnb"></i>
                </div>
                <div class="loader-spinner">
                    <div class="spinner-ring"></div>
                    <div class="spinner-ring"></div>
                    <div class="spinner-ring"></div>
                </div>
                <p class="loader-text">Loading your experience...</p>
            </div>
        </div>
        
        <div class="page d-flex flex-column min-vh-100">
            <%- include("../includes/navbar.ejs") %>
            <div
                class="container d-flex flex-column justify-content-center align-items-center mb-5 mt-2"
            >
                <%- include("../includes/flash.ejs") %> <%- body %>
            </div>
            <%- include("../includes/footer.ejs") %>
        </div>
        <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
        <script src="/js/script.js"></script>
        <script>
            // Hide loader when page is fully loaded
            window.addEventListener('load', function() {
                const loader = document.getElementById('loader-wrapper');
                loader.style.opacity = '0';
                setTimeout(() => {
                    loader.style.display = 'none';
                }, 500);
            });
        </script>
    </body>
</html>
