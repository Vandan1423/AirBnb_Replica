<% layout("/layouts/boilerplate") %>
<body>
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="card show-card col-lg-9 col-xl-7">
                <img
                    src="<%= listing.image.url %>"
                    class="card-img-top show-img"
                    alt="listing-image"
                    style="height: 300px; object-fit: cover"
                />

                <div class="card-body">
                    <h3 class="card-title mb-3">
                        <b> <%= listing.title %> </b>
                    </h3>
                    <p class="card-text fs-5 text-muted">
                        Owner : @<%= listing.owner.username %>
                    </p>
                    <p class="card-text fs-5 text-muted">
                        <%= listing.description %>
                    </p>

                    <div class="mb-4 mt-4">
                        <p class="card-text mb-2">
                            <b>Price:</b> &#8377; <%=
                            listing.price.toLocaleString("en-IN") %> / night
                        </p>
                        <p class="card-text mb-2">
                            <b>Location:</b>
                            <%= listing.location %>
                        </p>
                        <p class="card-text">
                            <b>Country:</b>
                            <%= listing.country %>
                        </p>
                    </div>

                    <% if(currUser && currUser._id.equals(listing.owner._id)){
                    %>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <a
                                href="/listings/<%= listing._id %>/edit"
                                class="btn btn-secondary submit-btn w-100"
                            >
                                Edit
                            </a>
                        </div>
                        <div class="col-md-6">
                            <form
                                action="/listings/<%= listing._id %>?_method=DELETE"
                                method="post"
                            >
                                <button
                                    class="btn btn-secondary submit-btn w-100"
                                >
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="row justify-content-center mt-4">
            <div class="col-lg-9 col-xl-7">
                <% if(currUser){ %>
                <hr />
                <h4>Leave a Review</h4>
                <form
                    action="/listings/<%= listing._id%>/reviews"
                    method="post"
                    novalidate
                    class="needs-validation mb-4"
                >
                    <div class="mb-3">
                        <label for="rating" class="form-label">Rating</label>
                        <div class="star-rating">
                            <input
                                type="radio"
                                id="5-stars"
                                name="review[rating]"
                                value="5"
                            /><label for="5-stars" class="star">&#9733;</label>
                            <input
                                type="radio"
                                id="4-stars"
                                name="review[rating]"
                                value="4"
                            /><label for="4-stars" class="star">&#9733;</label>
                            <input
                                type="radio"
                                id="3-stars"
                                name="review[rating]"
                                value="3"
                            /><label for="3-stars" class="star">&#9733;</label>
                            <input
                                type="radio"
                                id="2-stars"
                                name="review[rating]"
                                value="2"
                            /><label for="2-stars" class="star">&#9733;</label>
                            <input
                                type="radio"
                                id="1-star"
                                name="review[rating]"
                                value="1"
                            /><label for="1-star" class="star">&#9733;</label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea
                            class="form-control"
                            id="comment"
                            name="review[comment]"
                            rows="4"
                            required
                        ></textarea>
                        <div class="invalid-feedback">
                            Please add a comment to your review.
                        </div>
                    </div>
                    <button class="btn btn-secondary submit-btn">Submit</button>
                </form>

                <hr />
                <% }%>
                <h4>All Reviews</h4>

                <% if(listing.reviews && listing.reviews.length> 0) { %> <%
                for(review of listing.reviews){ %>
                <div class="card review-card">
                    <div class="card-body">
                        <div class="card-title">
                            <span>@<%= review.owner.username %></span>
                            <% if(currUser &&
                            review.owner._id.equals(currUser._id)){ %>
                            <form
                                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                method="post"
                                style="display: inline"
                                onsubmit="return confirm('Are you sure you want to delete this review?')"
                            >
                                <button
                                    type="submit"
                                    class="delete-icon"
                                    title="Delete review"
                                >
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                            <% } %>
                        </div>
                        <p
                            class="starability-result"
                            data-rating="<%= review.rating %>"
                            style="--rating: <%= review.rating * 20 %>%"
                        ></p>
                        <p
                            class="review-text collapsed"
                            id="review-<%= review._id %>"
                        >
                            <%= review.comment %>
                        </p>
                        <% if(review.comment.length> 150) { %>
                        <button
                            class="show-more-btn"
                            onclick="toggleReview('<%= review._id %>')"
                            id="btn-<%= review._id %>"
                        >
                            Show more
                        </button>
                        <% } %>
                    </div>
                </div>
                <% } %> <% } else { %>
                <p class="text-muted">
                    No reviews yet. Be the first to leave a review!
                </p>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        function toggleReview(reviewId) {
            const reviewText = document.getElementById("review-" + reviewId);
            const button = document.getElementById("btn-" + reviewId);

            if (reviewText.classList.contains("collapsed")) {
                reviewText.classList.remove("collapsed");
                button.textContent = "Show less";
            } else {
                reviewText.classList.add("collapsed");
                button.textContent = "Show more";
            }
        }
    </script>
</body>

<script src="/js/reviewScript.js"></script>
